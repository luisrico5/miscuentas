rules_version = '2';
// Reglas de seguridad de Firestore para el Dashboard de Extras con valores.
// Cada usuario sólo puede leer/escribir SU documento (id = su uid). Nadie más.
// Aunque alguien accediera, el contenido está cifrado (AES-GCM) y es ilegible sin la contraseña.
service cloud.firestore {
  match /databases/{database}/documents {
    match /dashboards/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
